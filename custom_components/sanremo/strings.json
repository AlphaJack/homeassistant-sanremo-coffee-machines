{
  "config": {
    "step": {
      "user": {
        "title": "Connect to your Sanremo machine",
        "description": "Make sure the machine's Wi-Fi module is connected to the same network as Home Assistant. The Sanremo Connector app shows the address on its device list.",
        "data": {
          "host": "Host"
        },
        "data_description": {
          "host": "IP address or hostname of the machine, for example 192.168.1.10"
        }
      },
      "reconfigure": {
        "title": "Change the machine address",
        "data": {
          "host": "Host"
        },
        "data_description": {
          "host": "The machine's new IP address or hostname"
        }
      }
    },
    "error": {
      "cannot_connect": "Could not reach the machine. Check the address, and that the machine is powered and on the network.",
      "invalid_response": "The device answered, but not like a Sanremo Wi-Fi module. Check that the address belongs to the machine.",
      "unknown": "Unexpected error"
    },
    "abort": {
      "already_configured": "This machine is already set up",
      "wrong_machine": "That address belongs to a different machine",
      "reconfigure_successful": "Address updated"
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Polling options",
        "data": {
          "scan_interval": "Polling interval"
        },
        "data_description": {
          "scan_interval": "Seconds between reads. The machine's Wi-Fi module is small and answers one request at a time, so keep this at 10 seconds or more unless you need faster updates."
        }
      }
    }
  },
  "exceptions": {
    "command_failed": {
      "message": "The machine rejected the command: {error}"
    },
    "invalid_operation_mode": {
      "message": "{mode} is not a supported operation mode for this machine."
    },
    "scheduler_unsupported": {
      "message": "This machine does not expose a programmable schedule."
    },
    "device_not_found": {
      "message": "No device found with ID {device_id}."
    },
    "device_not_loaded": {
      "message": "The Sanremo machine {device_id} is not loaded."
    }
  },
  "selector": {
