  "services": {
    "set_schedule_day": {
      "name": "Set schedule day",
      "description": "Replaces the on/off time slots for one weekday of the machine's built-in scheduler.",
      "fields": {
        "device_id": {
          "name": "Device",
          "description": "The Sanremo machine to configure."
        },
        "day": {
          "name": "Day",
          "description": "The weekday to overwrite."
        },
        "slots": {
          "name": "Time slots",
          "description": "Up to three on/off windows. Times are rounded to the machine's 15-minute grid. Any slot you leave out is cleared."
        },
        "copy_to": {
          "name": "Copy to",
          "description": "Other weekdays that should receive the same slots."
        }
      }
    }
